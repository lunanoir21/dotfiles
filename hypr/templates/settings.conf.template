#  ◈ SETTINGS (AUTOGENERATED FROM SETTINGS.JSON)
#
#  Bu dosyayı elle düzenleme — settings_watcher.sh her settings.json yazımında
#  templates/settings.conf.template'ten yeniden üretiyor. Değerler settings.json
#  içindeki "hypr" nesnesinden geliyor; anahtar yoksa buradaki varsayılan kullanılır.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

general {
    border_size = {{BORDER_SIZE}}
    gaps_in = {{GAPS_IN}}
    gaps_out = {{GAPS_OUT}}
    float_gaps = {{FLOAT_GAPS}}
    resize_on_border = {{RESIZE_ON_BORDER}}
    extend_border_grab_area = 30
    col.active_border=$active_border
    col.inactive_border=$inactive_border
}

decoration {
    rounding = {{ROUNDING}}
    active_opacity = {{ACTIVE_OPACITY}}
    inactive_opacity = {{INACTIVE_OPACITY}}
    blur {
        enabled = {{BLUR_ENABLED}}
        size = {{BLUR_SIZE}}
        passes = {{BLUR_PASSES}}
        new_optimizations = true
    }
    shadow {
        enabled = {{SHADOW_ENABLED}}
    }
}

input {
    kb_layout = {{KB_LAYOUT}}
    kb_options = {{KB_OPTIONS}}
    sensitivity = {{SENSITIVITY}}

    touchpad {
        natural_scroll = {{NATURAL_SCROLL}}
    }
}

cursor {
    no_warps = true
}

misc {
    font_family = {{FONT_FAMILY}}
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
}

ecosystem {
    no_update_news = true
    no_donation_nag = true
}

animations {
    enabled = {{ANIMATIONS_ENABLED}}
    bezier = myBezier, 0.05, 0.9, 0.1, 1.05
    animation = windows, 1, {{ANIM_SPEED}}, myBezier, popin 80%
    animation = windowsOut, 1, {{ANIM_SPEED}}, myBezier, popin 80%
    animation = layers, 1, {{ANIM_SPEED}}, myBezier, fade
    animation = layersIn, 1, {{ANIM_SPEED}}, myBezier, fade
    animation = layersOut, 1, {{ANIM_SPEED}}, myBezier, fade
    animation = fade, 1, {{ANIM_SPEED}}, myBezier
    animation = workspaces, 1, {{ANIM_SPEED}}, myBezier, slide
    animation = specialWorkspaceIn, 1, {{ANIM_SPEED}}, myBezier, fade
    animation = specialWorkspaceOut, 1, {{ANIM_SPEED}}, myBezier, fade
}
