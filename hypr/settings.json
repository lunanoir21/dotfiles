  "startup": [
    {
      "command": "systemctl --user start hyprpolkitagent"
    },
    {
      "command": "awww-daemon"
    },
    {
      "command": "hypridle"
    },
    {
      "command": "quickshell -p ~/.config/hypr/scripts/quickshell/Shell.qml"
    },
    {
      "command": "~/.config/hypr/scripts/init.sh"
    },
    {
      "command": "~/.config/hypr/scripts/settings_watcher.sh &"
    },
    {
      "command": "playerctld"
    },
    {
      "command": "swayosd-server --top-margin 0.9 --style \"$HOME/.config/swayosd/style.css\""
    },
    {
      "command": "wl-paste --type text --watch cliphist store"
    },
    {
      "command": "wl-paste --type image --watch cliphist store"
    },
    {
      "command": "~/.config/hypr/scripts/volume_listener.sh"
    }
  ],
  "hypr": {
    "borderSize": 0,
    "gapsIn": 4,
    "gapsOut": 4,
    "floatGaps": 6,
    "resizeOnBorder": true,
    "rounding": 4,
    "activeOpacity": 1,
    "inactiveOpacity": 1,
    "blurEnabled": true,
    "blurSize": 9,
    "blurPasses": 2,
    "shadowEnabled": false,
    "sensitivity": 0,
    "naturalScroll": true,
    "fontFamily": "JetBrains Mono",
    "animationsEnabled": true,
    "animSpeed": 5
  },
  "theme": "black",
  "deviceKind": "laptop",
  "powerPromptEnabled": false,
  "powerSaverMode": "normal",
  "powerSaverAnimStyle": "tint",
  "hardwareEnvs": [
    "# Firefox on Wayland: native window (not XWayland — correct fractional",
    "# scaling, smoother resize) + pin VAAPI hardware video decode to the Intel",
    "# iGPU (renderD129/iHD). This machine also has libva-nvidia-driver",
    "# installed for the dGPU (renderD128), but NVIDIA's Wayland VAAPI path is",
    "# far less reliable in Firefox than Intel's - pinning avoids Firefox",
    "# guessing wrong. MOZ_DISABLE_RDD_SANDBOX works around the sandboxed",
    "# decode process blocking /dev/dri access, the standard fix for this.",
    "env = MOZ_ENABLE_WAYLAND,1",
    "env = LIBVA_DRIVER_NAME,iHD",
    "env = MOZ_DISABLE_RDD_SANDBOX,1"
  ]
}