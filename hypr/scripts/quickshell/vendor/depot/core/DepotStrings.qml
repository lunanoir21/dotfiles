    function t(key) {
        let strings = root.table[root.lang] || root.table.en;
        return strings[key] !== undefined ? strings[key] : (root.table.en[key] || key);
    }

    // Catalog text carries one string per language.
    function pick(localized) {
        if (!localized) return "";
        if (typeof localized === "string") return localized;
        return localized[root.lang] || localized.en || "";
    }
